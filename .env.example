# Zeitnest Umgebungsvariablen
# Diese Datei kopieren nach .env und Werte anpassen

# JWT Secret - UNBEDINGT ändern! (z.B. openssl rand -hex 64)
JWT_SECRET=hier-ein-langes-zufaelliges-secret-eintragen

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=zeitnest
DB_USER=zeitnest
DB_PASSWORD=hier-ein-sicheres-db-passwort

# Port (Standard: 3001)
PORT=3001

# Node Environment
NODE_ENV=production

# SMTP / Mail
SMTP_HOST=mail.neotactiq.ai
SMTP_PORT=587
SMTP_USER=relay@mail.neotactiq.ai
SMTP_PASSWORD=
SMTP_FROM=noreply@zeitnest.org
BASE_URL=https://zeitnest.org

# Cloudflare Tunnel
CLOUDFLARED_TOKEN=

# Backup Sender (Synology NAS via Tailscale)
NAS_TAILSCALE_IP=100.101.43.67
RSYNC_ZEITNEST_PASSWORD=
BACKUP_HOUR=3
BACKUP_MINUTE=0
